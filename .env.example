# Public site origin, used for canonical URLs, sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL="https://meridianfacilities.com"

# Supabase project credentials. Both are server-side only: the service role key
# must never be exposed to the browser, so it has no NEXT_PUBLIC_ prefix.
# Find these in Supabase Dashboard -> Project Settings -> API.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
